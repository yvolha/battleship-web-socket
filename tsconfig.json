{
  "compilerOptions": {
    "target": "es2016",                                
    "lib": ["es6"],                                     
    "module": "es2020",                                 
    "rootDir": ".",                              
    "allowJs": true,                                    
    "checkJs": true,                                                                   
    "outDir": "dist",
    "allowSyntheticDefaultImports": true,                        
    "forceConsistentCasingInFileNames": true,           
    "strict": true,                                      
    "noImplicitAny": true,                              
    "skipLibCheck": true,
    "types": ["@types/node"],
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
